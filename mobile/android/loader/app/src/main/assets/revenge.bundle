cord.view-icons":()=>(CY(),T(IY)),"solcord.view-raw":()=>(TY(),T(_Y)),"solcord.voice-channel-log":()=>(qY(),T(DY)),"solcord.voice-chat-utilities":()=>(MY(),T(zY)),"solcord.voice-count":()=>(RY(),T(PY)),"solcord.voice-download":()=>(NY(),T(LY)),"solcord.voice-fake-detector":()=>(UY(),T(OY)),"solcord.voice-join-messages":()=>(FY(),T(BY)),"solcord.voice-rejoin":()=>(GY(),T($Y)),"solcord.voice-server-info":()=>(HY(),T(VY)),"solcord.voice-stats":()=>(WY(),T(KY)),"solcord.volume-booster":()=>(rX(),T(eX)),"solcord.wait-for-slot":()=>(aX(),T(tX)),"solcord.weather":()=>(nX(),T(oX)),"solcord.webcam-start-notifier":()=>(sX(),T(iX)),"solcord.wellbeing":()=>(cX(),T(uX)),"solcord.whitelisted-emojis":()=>(pX(),T(mX)),"solcord.who-reacted":()=>(hX(),T(fX)),"solcord.whos-watching":()=>(vX(),T(gX)),"solcord.wiki-lookup":()=>(bX(),T(yX)),"solcord.word-count":()=>(kX(),T(AX)),"solcord.write-upper-case":()=>(SX(),T(wX)),"solcord.xkcd":()=>(jX(),T(xX)),"solcord.zero-width-sanitizer":()=>(CX(),T(IX)),"solcord.zip-preview":()=>(WX(),T(KX))}});var XX=Oa((eRr,Ake)=>{Ake.exports={"solcord.add-attachments":"Allows you to add new attachments while editing messages","solcord.advice":"Send a random piece of advice with /advice","solcord.always-animate":"Animates anything that can be animated","solcord.always-trust":"Removes the annoying popup about leaving Discord for another website","solcord.animalese":"Plays animal crossing animalese for every message sent (they yap a lot)","solcord.anime-lookup":"Look up an anime's score, episodes and status with /anime","solcord.anonymise-file-names":"Anonymise uploaded file names","solcord.anti-delete-message":"Automatically resends your messages if someone deletes them. Cache persisted across restarts.","solcord.anti-move-deco":"Puts you back in your voice channel when someone moves or disconnects you","solcord.anti-nickname":"Automatically resets any nickname forcefully assigned to you in a server. Works even without admin permissions.","solcord.anti-snitch":"Alerts you with a sound and toast whenever selected users start typing in your current channel.","solcord.at-someone":"Mention a random member of the channel","solcord.auto-dnd-while-playing":"Automatically updates your online status (online, idle, dnd) when launching games","solcord.auto-disconnect-and-auto-mute":"Automatically disconnect or mute selected users from voice channels","solcord.auto-react":"Automatically react to messages containing specific keywords.","solcord.auto-vaporwave":"Turn every message you send into ｆｕｌｌｗｉｄｔｈ text automatically.","solcord.avatar-grabber":"/avatar grabs the full-resolution avatar of any user (or yourself).","solcord.banners-everywhere":"Displays banners in the member list","solcord.better-activities":"See everything a message's author is doing right now, from the message menu","solcord.better-ban-reasons":"Ban with /ban and your own saved reasons to pick from","solcord.better-blocked-users":"A searchable list of the people you blocked, to unblock them in one tap","solcord.better-commands":"Adds /refresh, which reloads the slash commands of a chat, its server or a bot when they don't show up","solcord.better-forwards":"A forwarded message from another server says which server it came from, next to its time.","solcord.better-gif-load":"Change the quality of GIFs in the GIF picker. Improves performance and lowers internet usage.","solcord.better-invites":"See where an invite leads, who made it and when it expires, before joining, with /inviteinfo","solcord.better-plus-reacts":"React to an earlier message by typing +:emoji:, with one + per message back","solcord.better-role-context":"See a role's color, icon, members and permissions with /roleinfo","solcord.better-sessions":"See your logged-in devices with exact times and your own names for them, and get told about new logins","solcord.block-keywords":"Blocks messages containing specific user-defined keywords, as if the user sending them was blocked.","solcord.blur-nsfw":"Hides attachments in age-restricted channels behind a spoiler until you tap them","solcord.bold-text":"/bold turns your message into 𝐮𝐧𝐢𝐜𝐨𝐝𝐞 bold (works where markdown can't).","solcord.bookmarks":"Privately bookmark messages (beyond Discord's 50-pin limit) from the message menu, then find and jump to them in the plugin's settings or with /bookmarks","solcord.bored-activity":"Get an idea of something to do with /bored","solcord.bypass-status":"Still get a pop-up from chosen people, channels and servers while you're on Do Not Disturb. Long-press a message to add its author, channel or server. Only while Discord is open: notifications when it's closed come from Discord's servers.","solcord.calculator":"/calc does quick maths right in the chat box.","solcord.call-timer":"Shows how long you have been in the current voice call","solcord.cancel-friend-request":"See the friend requests you sent and cancel them","solcord.cancel-friend-request-nc":"Cancel every friend request you sent with /cancelrequests","solcord.cat-facts":"Send a random fact about cats with /catfact","solcord.channel-notes":"Keep private notes on any channel, DM or group chat: rules, who is who, things to remember. Notes stay on your device.","solcord.char-info":"See the Unicode code points of every character in a text with /charinfo","solcord.character-counter":"Adds a character counter to the chat input","solcord.chatgpt":"Allows using ChatGPT directly in Discord with configurable settings","solcord.chatgpt-writing":"Enhance your messages with kaomoji, emoji, and autocorrect","solcord.clan-switcher":"Automatically switches your Discord server tag","solcord.clap-text":"Adds /clap to 👏 put 👏 claps 👏 between 👏 your 👏 words.","solcord.clear-my-messages":"Delete your recent messages in a channel with /clearmessages","solcord.clear-urls":"Automatically removes tracking elements from URLs you send","solcord.click-sparkles":"Sprinkles little neon sparkles wherever you touch","solcord.client-side-block":"Allows you to locally hide almost all content from any user","solcord.color-info":"See a color's RGB and HSL values, or get a random one, with /colorinfo","solcord.color-text":"/color writes your message in color, using the colored code blocks Discord can show.","solcord.console-janitor":"Turns off Discord's console logging, which saves work on slower phones","solcord.content-warning":"Hides messages with trigger words you choose behind a spoiler you tap to reveal","solcord.copy-emoji-markdown":"Allows you to copy emojis as formatted string (<:blobcatcozy:1026533070955872337>)","solcord.copy-file-contents":"Copy the contents of text file attachments from the message menu","solcord.copy-media-link":"Copy the link of a message's images, videos and files from the message menu","solcord.copy-profile-colors":"Copy the profile theme colors of a message's author from the message menu","solcord.copy-status-urls":"Copy the links in the status of a message's author from the message menu","solcord.copy-sticker-links":"Adds the ability to copy & open Sticker links","solcord.copy-user-mention":"Copy the mention of a message's author from the message menu","solcord.copy-user-urls":"Copy a link to the profile of a message's author from the message menu","solcord.countdown":"See how long is left until a date with /countdown","solcord.country-info":"Look up a country's capital, population, languages and currency with /country","solcord.crypto-prices":"See a cryptocurrency's price and its change today with /crypto","solcord.currency-converter":"Convert between currencies at today's rates with /currency","solcord.custom-badge":"Upload two custom image badges and share them with other Solcord users on phones and PCs.","solcord.custom-commands":"Allows you to create custom slash commands / tags","solcord.custom-idle":"Stops Discord from marking you idle while the app is in the background","solcord.custom-profile":"Visually customize your Discord profile (username, PFP, banner, badges, bio...). Other Solcord users see it too.","solcord.custom-rpc":"Add a fully customisable Rich Presence (Game status) to your Discord profile","solcord.custom-reaction-buttons":"Add your own one-tap reactions to the message menu","solcord.custom-sounds":"Customize Discord's sounds.","solcord.custom-status-timeouts":`Adds configurable timeout presets to the custom status' "Clear after" choices.`,"solcord.custom-timestamps":"Shows message times in a format you choose","solcord.custom-user-colors":"Give any user a custom name color in chat","solcord.dearrow":"Makes YouTube embed titles less sensationalist with Dearrow; the ID of every YouTube video you see is sent to sponsor.ajay.app","solcord.declutter":"Cleans up Discord by removing profile effects and avatar decorations","solcord.decode-base64":"Decode base64 content of any message and copy the decoded content.","solcord.decor":"Shows the custom avatar decorations people picked with Decor on Solcord PC and other clients","solcord.default-status-forever":"Make statuses default to last forever","solcord.dictionary":"Look up what an English word means with /define","solcord.disable-call-idle":"Disables automatically getting kicked from a DM voice call after 3 minutes and being moved to an AFK voice channel.","solcord.disable-cameras":"Disables cameras in a call by default","solcord.discord-dev-banner":"Enables Discord's developer banner, which shows the build ID","solcord.discord-status":"Check whether Discord itself is having problems with /discordstatus","solcord.dont-round-my-timestamps":"Always rounds relative timestamps down, so 7.6y becomes 7y instead of 8y","solcord.download-all-attachments":"Download every attachment of a message at once from the message menu","solcord.draft-list":"Lists every chat where you left a message unsent, so you can go back and finish it. Open it from Solcord Toolbox or this plugin's settings.","solcord.earthquakes":"See the latest strong earthquakes around the world, or near a place, with /earthquakes","solcord.embedded-urls":"Turns plain social links into embeddable URLs so posts and videos are fully viewable in Discord instead of forcing users to open the external site.","solcord.emojify":"Write a message in big letter emojis with /emojify","solcord.encrypted-message":"Send messages encrypted with a password with /encrypt; only people with the password can read them","solcord.event-logs":"Keeps a log of deleted and edited messages, friends added and removed, and servers you join and leave","solcord.exit-sounds":"Play soundboard sounds when you disconnect from voice.","solcord.experiments":"Enable Access to Experiments & other dev-only features in Discord!","solcord.export-dm":"Export a chat's messages, attachments, stickers and reactions as TXT, Markdown or JSON with /exportdm","solcord.export-messages":"Share any message as text from the message menu","solcord.expression-cloner":"Clone custom emojis from a message to your own servers from the message menu","solcord.fake-connections":"Add fake connections to your own profile, visible only to you.","solcord.fake-dm":"Injects fake local messages into a DM or group DM with /fakedm. They stay after Discord restarts; only you see them.","solcord.fake-friends":"Locally simulates Discord friends and friend requests. Only you see them, and they're gone when Discord restarts.","solcord.fake-message":"Send a client-side fake message posed as any user via /fakemsg. Only you can see it.","solcord.fake-mute":"Appear muted or deafened to others in voice channels while your microphone and sound keep working.","solcord.fake-nitro":"Use any emoji and sticker without Nitro: the ones you can't use are sent as links.","solcord.fake-nitro-age":"Set how many months or years of Nitro your profile shows. Only you see this.","solcord.fake-profile-themes":"Allows profile theming by hiding the colors in your bio thanks to invisible 3y3 encoding","solcord.fake-request-count":"Shows as many friend and message requests as you like on Discord's badges. Only the numbers, only on your screen.","solcord.fake-server":"Make any server look verified or partnered, with as many members as you like, with /fakeserver in that server. Only on your screen.","solcord.fake-tag":"Adds a fake clan tag and badge emoji next to your username. Client-side only.","solcord.favorite-emoji-first":"Puts your favorite emoji first in the emoji autocomplete.","solcord.favorite-anything":"Favorite any image, video, or file attachment","solcord.file-splitter":"Split large files into multiple parts to bypass size limits and share them easily. Only people with Solcord can join the parts back into the file: long-press a part to join and save it.","solcord.file-upload":"Upload files to hosting services like Zipline, Nest, S3, and WebDAV","solcord.file-viewer":"View Word, Excel and PowerPoint attachments from the message menu; the file is opened by Microsoft's online viewer, which downloads it","solcord.find-reply":"Jumps to the earliest reply to a message in a channel (lets you follow past conversations more easily).","solcord.fix-file-extensions":"Fixes file extensions by renaming them to a compatible supported format if possible","solcord.fix-images-quality":"Improves quality of images by loading them at their original resolution. Uses more mobile data.","solcord.focus-mode":"One switch for Do Not Disturb, for a while or until you turn it off, and back to your previous status when it ends","solcord.follow-user":"Follow someone from the message menu to always join the same voice channel as them","solcord.friend-codes":"Create and manage friend invite links in the plugin's settings, to add friends easily","solcord.friend-invites":"Create, list and revoke friend invite links with /friendinvites","solcord.friend-nicknames":"Give people your own nicknames that only you see in chat","solcord.friend-tags":"Give friends your own tags and list everyone with a tag with /friendtag","solcord.friendship-ranks":"Adds badges showcasing how long you have been friends with a user for","solcord.game-activity-toggle":"Adds a button beside the message box and /gameactivity to show or hide what you're playing","solcord.ghosted":"Keeps a list of the DMs you haven't answered yet, with a ghost for each","solcord.gif-collections":"Allows you to create collections of gifs.","solcord.gif-paste":"Makes picking a gif in the gif picker insert a link into the chatbox instead of instantly sending it","solcord.gif-provider-switcher":"Allows you to use Tenor or Giphy GIF search instead of Klipy","solcord.github-lookup":"Look up a GitHub user or repository with /github","solcord.github-repos":"See the public GitHub repositories of a message's author from the message menu","solcord.global-badges":"Adds global badges from other client mods","solcord.google-that":"Send a web search link for anything with /googlethat","solcord.greet-sticker-picker":"Wave to someone in a new DM or a new member with the sticker you pick, with /greet","solcord.guild-picker-dumper":"Share the links of every emoji and sticker of a server with /dumpemojis","solcord.hash":"Get the SHA-256 hash of a text with /sha256","solcord.hide-chat-buttons":"Able to hide the chat buttons","solcord.hide-media":"Hide the attachments and embeds of a message from the message menu","solcord.hide-messages":"Hide messages from the message menu until you restart Discord","solcord.hide-servers":"Hide servers from your server list with /hideserver, and bring them back from the plugin's settings","solcord.hide-solcord":"Hides Solcord's entries in Discord's settings, for screenshots and screen sharing. Plugins keep working.","solcord.holidays":"See a country's next public holidays with /holidays","solcord.hop-on":"Hop on! Opens a configurable URL when a message matches a custom regex in the current channel.","solcord.husk":"React with husk from the message menu (change the emoji in settings)","solcord.hypesquad-switcher":"Easily switch between HypeSquad houses or remove your badge","solcord.i-love-spam":"Do not hide messages from 'likely spammers'","solcord.i-remember-you":"Remembers everyone you talk to in DMs and servers, on your device, so you can always find them again","solcord.icon-viewer":"Browse and search all of Discord's icons in the plugin's settings, and copy their names","solcord.id-translater":"Automatically translates Discord IDs to clickable @ mentions or # references","solcord.idle-auto-restart":"Reloads Discord when you come back after leaving it in the background for a while, so it starts fresh, but never during a call","solcord.ignore-calls":"Allows you to ignore calls from specific users or dm groups.","solcord.image-link":"Never hide image links in messages, even if it's the only content","solcord.implicit-relationships":"See the people Discord thinks you talk to most, even if they aren't your friends, with /implicit","solcord.in-role":"See who has a role with /inrole","solcord.invisible-chat":"Hide a secret, password-protected message inside an ordinary one with /invisible","solcord.invite-defaults":"Create invites with your own defaults for how long they last and how many uses they have, with /invite","solcord.irc-colors":"Makes username colors in chat unique, like in IRC clients","solcord.jokes":"Send a random joke with /joke","solcord.jump-to":"Jump to the first or the latest message of a chat with /jumpto","solcord.jumpscare":"Adds a configurable chance of jumpscaring you whenever you open a channel. Inspired by Geometry Dash Mega Hack","solcord.keyword-notify":"Sends a notification if a given message matches certain keywords or regexes","solcord.last-active":"Jump to the last message of yourself or someone else in a chat with /lastactive","solcord.lastfm-rich-presence":"Shows what you're listening to on Last.fm as your Rich Presence","solcord.last-online":"Remembers when your friends were last online; see it in the message menu or with /lastonline","solcord.leet-text":"/leet rewrites your message in 1337 5p34k.","solcord.local-times":'When a message has a time with a time zone in it, like "8pm EST" or "14:00 UTC", shows that time in your own time zone under it.',"solcord.lorem-ipsum":"Put placeholder text in the message box with /lorem","solcord.markdown-tables":"Render GitHub-style markdown tables in Discord messages.","solcord.member-count":"See how many members a server has, how many are online and how many are in voice, with /membercount","solcord.mention-colors":"Marks messages that mention you directly differently from @everyone and @here pings","solcord.message-burst":"Merges messages sent within a time period with your previous sent message if no one else sends a message before you.","solcord.message-colors":"Shows a colored square beside color codes like #FF0042 in messages: the closest of the colored square emoji, as the phone's chat can't draw other colors.","solcord.message-fetch-timer":"Shows how long it took to fetch messages for the current channel","solcord.message-latency":"Displays an indicator for messages that took ≥n seconds to send","solcord.message-link-embeds":"Adds a preview to messages that link another message","solcord.message-logger":"Keeps deleted messages in the chat and shows earlier versions of edited ones.","solcord.message-logger-enhanced":"Keeps deleted and edited messages after Discord restarts, with a list to browse them and /deleted","solcord.message-notifier":"Get a pop-up when chosen users send a message. Only while Discord is open: notifications when it's closed come from Discord's servers.","solcord.message-reminders":"Get reminded about a message later from the message menu. The reminder links right back to it.","solcord.message-tags":"Tag messages with private labels (TODO, Important, ...) shown next to their time, and find them in the plugin's settings","solcord.message-translate":"Auto translate messages to your language with caching, per-channel toggles, and more options; the messages are sent to Google Translate","solcord.message-vault":"Search messages you have read by keyword and person with /vault, even after they scroll away. Indexed on your device only.","solcord.minecraft-skin":"Send a Minecraft player's skin with /mcskin","solcord.minecraft-status":"See whether a Minecraft server is online and how many are playing with /mcstatus","solcord.more-commands":"Adds various fun and useful commands","solcord.more-jumbo-emoji":"Unlock the maximum amount of jumbo emoji","solcord.more-stickers":"Adds sticker packs from other social media platforms. (e.g. LINE)","solcord.more-user-tags":"Adds tags for webhooks and moderative roles (owner, admin, etc.)","solcord.moyai":"Plays a 🗿 sound effect whenever a moyai emoji is sent or reacted in the chat you have open","solcord.music-rich-presence":"Rich Presence for what you're playing, from ListenBrainz","solcord.mutual-group-dms":"See the group DMs you share with a message's author, from the message menu","solcord.mutual-server-members":"Compare two servers you're in and see which members are in both, with /mutualmembers","solcord.new-guild-settings":"Automatically mute new servers and change various other settings upon joining","solcord.no-blocked-messages":"Hides all blocked/ignored messages from chat completely","solcord.no-dm-while-streaming":"While you share your screen, hides DMs from your DM list, silences their in-app pop-ups and sounds, and marks them as read. Android's own notifications come from Discord's servers and still show.","solcord.no-draft-length-limit":"Removes the 4500 character saved draft message truncation","solcord.no-nitro-upsell":"Hides Discord's Nitro ads: the banners, cards and buttons that advertise Nitro around the app","solcord.no-pending-count":"Removes the badge count of incoming friend requests and message requests","solcord.no-profile-themes":"Completely removes Nitro profile themes from everyone but yourself","solcord.no-push-to-talk":"Bypasses the push-to-talk requirement for voice activity in channels that enforce it.","solcord.no-reply-mention":"Disables reply pings by default","solcord.no-track":"Stops Discord from collecting analytics, metrics and crash reports about how you use the app","solcord.no-unblock-to-jump":"Allows you to jump to messages of blocked or ignored users and likely spammers without unblocking them","solcord.normalize-message-links":"Strip canary/ptb from message links","solcord.notification-volume":"Save your ears and set a separate volume for notifications and in-app sounds","solcord.npm-lookup":"Look up an npm package's version, licence and downloads with /npm","solcord.one-ping-per-dm":"If unread messages are sent by a user in DMs multiple times, you'll only hear one ping while Discord is open. Read the messages to reset the limit.","solcord.oneko":"A little cat that runs to wherever you touch the screen.","solcord.open-in-app":"Open links in their respective apps instead of your browser","solcord.override-forum-defaults":"Allows you to override default forum layout/sort order. you can still change it on a per-channel basis","solcord.owner-badge":"Redeem verified Solcord staff keys and display up to three unlocked badges together on phones and PCs.","solcord.password-generator":"Make a strong random password with /passwordgen; only you see it, and it is copied","solcord.pause-invites-forever":"Pause a server's invites with no time limit, which Discord no longer offers, with /pauseinvites","solcord.pdf-viewer":"Preview PDF attachments from the message menu; the file is opened by Google's online viewer, which downloads it","solcord.permission-free-will":`Lets you deny channel permissions and delete channels without Discord's onboarding check ("Making this change will make your server incompatible [...]").`,"solcord.permissions-viewer":"See the roles and permissions of a message's author from the message menu","solcord.pin-dms":"Pin DMs to the top of your DM list with /pindm","solcord.pin-icon":"Adds a pin icon to pinned messages","solcord.ping-notifications":"Customizable notifications with improved mention formatting","solcord.platform-indicators":"Shows which devices people are online on (desktop, web, mobile, console or VR), in the color of their status, beside their name and on their profile.","solcord.pokedex":"Look up a Pokémon's types and stats with /pokemon","solcord.polish-wording":"Tweaks your messages to make them look nicer and have better grammar. See settings","solcord.preview-message":"Lets you preview your message before sending it.","solcord.privacy-curtain":"Keeps your chats out of the recent apps screen, and if you like out of screenshots and screen recordings too.","solcord.profile-media":"Open a message author's avatar and banner in full resolution from the message menu","solcord.profile-sets":"Allows you to save and load different profile presets.","solcord.pronoundb":"Shows people's pronouns from PronounDB next to their messages; the IDs of the people you see are sent to pronoundb.org","solcord.pull-user-into-voice":"Pull a message's author into your voice channel from the message menu, and keep pulling them if you like","solcord.qr-code":"Send a QR code of any text or link with /qr; the text is sent to api.qrserver.com, which draws it","solcord.questify":"Hides Discord's Quests and their promotions, and the Quest badges on profiles. Never completes Quests for you.","solcord.quick-delete":"Delete your last message in a channel with /deletelast, or any of yours from the message menu without confirming","solcord.quick-mention":"Mention a message's author from the message menu","solcord.quick-theme-switcher":"Switch between your installed themes with /theme or a button beside the message box","solcord.quoter":"Quote a message into your message box, or make an inspirational quote picture of it to send, from the message menu","solcord.quotes":"Send a random famous quote with /quote","solcord.random-facts":"Send a random fact with /fact","solcord.random-voice":"Join a random voice channel with /randomvoice","solcord.reaction-timestamps":"Shows when each reaction was added, from the message menu. Only reactions added while the app is open are known.","solcord.read-all-notifications":"Mark every server as read at once with /readall","solcord.realtime-timestamps":"Shows the seconds in every message's time (e.g. 15:34:21)","solcord.recent-channel-switcher":"Go back to the channels and DMs you opened recently with /recent","solcord.recent-dm-switcher":"Go back to the DMs you opened recently with /recentdms","solcord.recipe-finder":"Find a recipe for a dish with /recipe","solcord.relationship-notifier":"Notifies you when a friend, group chat, or server removes you.","solcord.remind-me":"/remindme reminds you of something later with a notice in the chat. Survives restarts.","solcord.remix-revived":"Draw on a picture and send it, like Discord's old Remix: long-press a picture and choose Remix, or pick one from your phone.","solcord.reorder-attachments":"Allows you to reorder attachments before sending them","solcord.repeat-messages":"Send a message again from the message menu","solcord.reply-chain":"Long-press a reply to see the whole conversation it answers, from the first message down, on one page.","solcord.reply-ping-control":"Control whether to always or never get pinged on message replies, with whitelist and blacklist features","solcord.reply-timestamp":"Shows when the message a reply answers was sent, next to the reply's time","solcord.reveal-all-spoilers":"Reveal every spoiler in a message from the message menu","solcord.reverse-image-search":"Search for a message's image on Google Lens, Yandex, SauceNAO and more from the message menu; the image's link is sent to the search engine you pick","solcord.reverse-text":"/reverse flips your message backwards.","solcord.review-db":"Read the ReviewDB reviews of a message's author from the message menu","solcord.rich-magnet-links":"Shows magnet links in messages as a magnet and the file's name, and adds Copy Magnet Link to the message's long-press menu.","solcord.rich-presence":"Rich presence for what you play on AudioBookShelf, stats.fm, Jellyfin, Navidrome and Gensokyo Radio","solcord.rock-paper-scissors":"Play rock, paper, scissors with /rps and send the result","solcord.role-color-everywhere":"Tints the text of chat messages with the author's top role color.","solcord.save-favorite-gifs":"Export favorited GIF urls","solcord.scheduled-messages":"Schedule messages to be sent at a specific time or after a delay.","solcord.secret-guard":"Stops a message that looks like it has a token, key, password or card number in it. Send it again to send it anyway.","solcord.secret-ring-tone":"Always play the secret version of the Discord ringtone (except during special ringtone events), for calls that ring while Discord is open","solcord.sed-enhanced":"Edit your last message with s/find/replace/, with regular expressions, flags and other separators like s|a|b|g","solcord.self-destruct":"Sends messages that are automatically deleted after a configurable delay. Red timer visible on each message.","solcord.send-timestamps":"Times written like `14:30` become timestamps everyone sees in their own time zone; a chat bar button inserts the current time","solcord.server-backup":"Export a server's channels, roles and permissions to a backup file with /serverbackup","solcord.server-info":"Allows you to view info about a server","solcord.server-list-indicators":"See how many of your friends are online and how many servers you're in with /indicators","solcord.server-pinner":"Pin servers to the top of your server list with /pinserver, without changing your folders","solcord.server-search":"Find a server by name with /servers and open it from the result","solcord.ship-calc":"/ship rates the love between two people.","solcord.shorten-url":"Shorten a link with /shorten through is.gd; the short link goes in the message box","solcord.show-badges-in-chat":"Shows the message author's badges beside their name in chat.","solcord.show-connections":"See the accounts a message's author has connected (GitHub, Steam, Spotify...) from the message menu","solcord.show-hidden-channels":"See the channels of a server you can't open, with a lock, and what's visible about each: its topic, settings and who can see it. Open the list with /hiddenchannels or from SolcordToolbox.","solcord.show-me-your-name":"Display usernames next to nicks, or no nicks at all","solcord.show-roles-in-chat":"Shows a user's highest role next to their name in chat messages","solcord.show-song-name":"Shows song name instead of artist for Spotify activity","solcord.show-timeout-duration":"Shows how much longer a user's timeout will last next to their messages","solcord.signature":"Adds your signature to the end of every message you send","solcord.silence-users":"Silences @mention pings and server badge counts from specific users. Regular messages and DMs are untouched.","solcord.silent-delete":'"Silently" deletes a message. Bypass message loggers by replacing the message with a placeholder.',"solcord.silent-edit":"Hides the '(edited)' label on your own edited messages. The message stays — nothing is deleted or resent.","solcord.silent-message-toggle":"Adds a button to the chat bar to toggle sending a silent message.","solcord.silent-typing":"Hide that you are typing","solcord.smooth-type":"Fully customize the cursor caret — transition delay, easing, and color — for a smooth typing animation.","solcord.snowfall":"Let it snow on Discord","solcord.snowflake-info":"See when any Discord ID (a user, message, server...) was made with /snowflake","solcord.solcord-toolbox":"Adds a button beside the message box with Solcord quick actions: reload, turn off plugins, debug info and safe mode","solcord.song-link":"Open song links on your streaming service through song.link, from the message menu","solcord.sort-friend-requests":"Your incoming friend requests, newest first, to accept or ignore in the plugin's settings","solcord.sort-reactions":"Sorts reactions by count in chat.","solcord.space-launches":"See the next rocket launches with /launches","solcord.space-out":"/spaceout p u t s   s p a c e s   between every letter.","solcord.split-large-messages":"Splits oversized messages into Discord-sized chunks before sending.","solcord.spotify-activity-toggle":"Adds a toggle button for Spotify activity visibility.","solcord.spotify-lyrics-status":"Shows the line of the Spotify song you're listening to as your custom status, in time with the song. Needs Spotify connected to Discord","solcord.spotify-share-commands":"Share your current Spotify track, album or artist via slash command (/track, /album, /artist)","solcord.starify":"Adds /starify to wrap your message in sparkles ｡ﾟ☆.","solcord.startup-timings":"Shows how long Solcord and each of its plugins took to start, in the plugin's settings","solcord.status-presets":"Allows you to remember your statuses and set them later","solcord.status-while-active":"Automatically updates your online status when in a voice channel.","solcord.steam-lookup":"Look up a game's price on Steam with /steam","solcord.sticker-blocker":"Allows you to block stickers from being displayed.","solcord.sticker-paste":"Makes picking a sticker in the sticker picker add it to your next message instead of sending it at once. A sticker button beside the message box shows the stickers waiting.","solcord.stop-auto-unread":'Stops Discord from automatically bumping a channels notification setting to "All Messages"',"solcord.streaks":"Shows a streak next to a user when you exchange DMs with them on consecutive days.","solcord.stream-proof":"Hides messages and their images while you share your screen or record it. Toggle via chat bar button.","solcord.surface-translate":"Translate a channel's name and topic with /translatechannel; they are sent to Google Translate","solcord.suspicious-links":"Warns you under a message when a link in it only pretends to be a site like Discord or Steam: look-alike names, letters from other alphabets and links that hide where they go. Nothing is looked up online.","solcord.talk-in-reverse":"Reverses the message content before sending it.","solcord.tenor-gif-fix":"Saves Tenor GIFs as real GIFs instead of videos","solcord.text-replace":"Replace text in your messages. You can find pre-made rules in the #textreplace-rules channel in Solcord's Server","solcord.theme-library":"Browse and install themes for Discord on your phone without leaving the app.","solcord.timezones":"Shows the local time of the users you choose next to their messages","solcord.toast-notifications":"Show a pop-up toast notification, configurable for DMs, group, friends, or guild channels.","solcord.tone-indicators":"Explains tone indicators like /srs and /gen next to them in messages","solcord.translate":"Translate messages from the message menu, translate what you send, or use /translate, with Google Translate, DeepL or Kagi; the text is sent to the service you pick","solcord.translate-plus":"Rewrite your text in fun styles (small caps, upside down, fraktur, pirate...) with /translateplus","solcord.trivia":"Answer a random trivia question with /trivia","solcord.trivia-ai":"A plugin that helps you answer trivia questions using AI.","solcord.unindent":"Trims leading indentation from codeblocks","solcord.unit-converter":"Convert metric and imperial units in a message from the message menu","solcord.universal-volume":"Sets everyone in your voice channel to the same volume, and keeps new people who join at that level too.","solcord.unread-count-badge":"See how many unread messages each channel of a server has with /unread","solcord.unsuppress-embeds":"Allows you to unsuppress embeds in messages","solcord.urban-dictionary":"Look up slang on Urban Dictionary with /urban","solcord.url-highlighter":"Colors messages with links that match your patterns","solcord.user-messages-pronouns":"Shows people's pronouns from their Discord profile next to their messages","solcord.userpfp":"Allows you to use an animated avatar without Nitro","solcord.user-voice-show":"Shows an indicator on messages from people in a voice channel, and lets you join them from the message menu","solcord.usrbg":"Displays user banners from USRBG, allowing anyone to get a banner without Nitro","solcord.uuid-generator":"Make a random UUID with /uuid and copy it","solcord.valid-reply":'Fixes "Message could not be loaded" on replies: long-press the reply and choose Load Replied Message.',"solcord.valid-user":"Fix mentions for unknown users showing up as '@unknown-user' (long-press the message and choose Load Mentioned Users)","solcord.vibe-check":"Adds /vibe to drop a random vaporwave mood into chat.","solcord.vibrate-on-ping":"Vibrates your phone when someone mentions you or DMs you while Discord is open","solcord.view-icons":"Tap avatars, banners and server icons to see them full size.","solcord.view-raw":"View and copy the raw content and data of any message","solcord.voice-channel-log":"Logs voice channel activity: joins, leaves, moves, server mutes, cameras and screen shares","solcord.voice-chat-utilities":"Disconnect, move, mute or deafen everyone in your voice channel at once with /voiceall","solcord.voice-count":"See how many people are in each voice channel of a server with /voicecount","solcord.voice-download":"Download voice messages from the message menu","solcord.voice-fake-detector":"Tells you when someone in your voice channel shows as muted or deafened but is talking","solcord.voice-join-messages":"Receive client-side ephemeral messages when your friends join voice channels","solcord.voice-rejoin":"Rejoins DM/Server call automatically when restarting Discord.","solcord.voice-server-info":"Shows the Discord voice server you're connected to and its ping","solcord.voice-stats":"Shows how long you've spent in voice with each user","solcord.volume-booster":"Set a person's or a stream's volume above 200% with /volumebooster. Moving Discord's own volume slider for them ends the boost.","solcord.wait-for-slot":"Automatically join a full voice channel when a slot opens.","solcord.weather":"See the weather anywhere with /weather","solcord.webcam-start-notifier":"Tells you when someone in your voice channel turns their camera on or off","solcord.wellbeing":"A gentle, private dashboard of how you use Discord: screen time, messages and break reminders. Everything stays on your phone.","solcord.whitelisted-emojis":"Adds the ability to disable all message emojis except for a whitelisted set.","solcord.who-reacted":"See who reacted to a message with each emoji, from the message menu","solcord.whos-watching":"See who is watching your stream with /viewers","solcord.wiki-lookup":"/wiki pulls a short Wikipedia summary for anything (sent only to you).","solcord.word-count":"Shows the word count of messages next to their time","solcord.write-upper-case":"Changes the first Letter of each Sentence in Message Inputs to Uppercase","solcord.xkcd":"Send an xkcd comic, the latest, a random one or a number, with /xkcd","solcord.zero-width-sanitizer":"Removes invisible zero-width characters from messages to prevent fingerprinting and tracking","solcord.zip-preview":"Look inside ZIP files in chats, read and save the files in them, and zip files from your phone into one to send."}});var eJ={};E(eJ,{default:()=>ZX});function kke({def:e,value:r,onChange:t}){var[a,o]=(0,JX.useState)(String(r)),n=Number(a),i=a.trim()!==""&&Number.isFinite(n)&&n>=e.min&&n<=e.max;return f(gr,{label:d(e.label),description:e.description?d(e.description):void 0,value:a,keyboardType:"numeric",onChange:l=>{o(l);var u=Number(l);l.trim()!==""&&Number.isFinite(u)&&u>=e.min&&u<=e.max&&t(u)},state:i?void 0:"error",errorMessage:i?void 0:d("Enter a number from {min} to {max}",{min:e.min,max:e.max})})}function QX({id:e,def:r,store:t}){return f(Ut,{label:d(r.label),subLabel:r.description?d(r.description):void 0,value:!!(t[e]??r.default),onValueChange:a=>t